# The engine server as a systemd system service, restarted whenever it exits.
# Install (on the GPU machine): see engine/README.md, section "Process supervision".
# Logs: journalctl -u madhacks-engine -f

[Unit]
Description=MadHacks real-time video engine (port 8000)
After=network-online.target
Wants=network-online.target
# Never stop restarting: the default start limit would give up after 5 starts in 10 s.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/madhacks
# The same as `source ~/engine-venv/bin/activate`.
Environment=VIRTUAL_ENV=/home/ubuntu/engine-venv
Environment=PATH=/home/ubuntu/engine-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/engine-venv/bin/python -m engine.server --backend causal_forcing --reader commands --width 672 --height 384 --backend-opt vae=taehv --reanchor on --host 127.0.0.1 --port 8000 --record-dir /home/ubuntu/recordings
Restart=always
RestartSec=2
# SIGTERM goes to the server only; it shuts down cleanly and closes ffmpeg's input so the recording is finalized.
# With the default (control-group) ffmpeg would get SIGTERM at the same moment and cut the file short.
# Anything still running after the server exits (or after TimeoutStopSec) gets SIGKILL.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
